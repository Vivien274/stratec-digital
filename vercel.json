{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(.*)stratec-digital\\.fr"
        }
      ],
      "destination": "https://stratec-digital.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/qui-sommes-nous",
      "permanent": true
    },
    {
      "source": "/services-tarifs.html",
      "destination": "/services-et-tarifs",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/portfolio.html",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/RGPDcookies.html",
      "destination": "/rgpd-cookies",
      "permanent": true
    },
    {
      "source": "/mentionslegales.html",
      "destination": "/mentions-legales",
      "permanent": true
    }
  ]
}
