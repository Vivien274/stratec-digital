datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Pack {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  tagline           String
  price             String
  billingPeriod     String   @default("une fois")
  popularBadge      Boolean  @default(false)
  allowSplitPayment Boolean  @default(true)
  features          String   // JSON string of features array
  description       String
  audience          String
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Project {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  clientName        String
  category          String   // Vitrine, E-commerce, Sur-Mesure, Webdesign
  year              String
  summary           String
  challenge         String?
  solution          String?
  result            String?
  testimonialText   String?
  testimonialAuthor String?
  image             String
  gallery           String?  // JSON array string
  liveUrl           String?
  featured          Boolean  @default(false)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model FreeResource {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  category     String   @default("Guide PDF") // Guide PDF, Checklist, Modèle, Vidéo
  description  String
  image        String?  // Thumbnail / preview image URL
  downloadUrl  String?  // Direct link or Mailchimp trigger URL
  mailchimpTag String?  // Mailchimp audience tag / campaign ID
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LeadMessage {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  name            String
  email           String
  phone           String?
  activity        String?  // Plombier, Paysagiste, Coiffeur, etc.
  serviceInterest String?
  message         String
  status          String   @default("NEW") // NEW, READ, CONTACTED, ARCHIVED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
